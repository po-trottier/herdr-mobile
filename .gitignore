# herdr-mobile ignore list.
# This repository holds documentation and agent guidance only. It has no build
# output, so this file covers documentation-check artefacts, agent-local files,
# and editor or operating-system noise. An implementation repository adds its own
# build entries.

# ── Documentation check artefacts ────────────────────────────────────────────
# Mermaid diagrams are rendered to a temporary directory to prove they parse.
# The images are never committed. See CONTRIBUTING.md, "Validate the documentation".
*.mmd.svg
*.mmd.png
/.mermaid-tmp/

# lychee link-check cache.
.lycheecache

# npx download cache, if a run is configured to keep one locally.
/.npm/
/node_modules/

# Rust build output (crates/Cargo.toml workspace, Phase 0 onward).
/crates/target*/

# ── Agent-local files ────────────────────────────────────────────────────────
# Personal, per-machine agent instructions. The shared instructions live in
# AGENTS.md and are committed. See docs/decisions/ADR-006-agent-instruction-files.md.
CLAUDE.local.md
AGENTS.local.md
.claude/settings.local.json
.codex/
.omp/
# tokf output-compression cache, written wherever a filtered command runs.
.tokf/

# ── Editor ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Operating system ─────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

# flutter_test golden diff artifacts (matchesGoldenFile writes them beside the test)
app/test/**/failures/

# Operator-supplied Firebase configuration.
/app/android/app/google-services.json

# Relay push credentials (R-14-017). The README stays.
/deploy/relay/secrets/*
!/deploy/relay/secrets/README.md

# Opt-in iOS push entitlement for a paid Apple team (R-22-089).
/app/ios/Flutter/Push.xcconfig
